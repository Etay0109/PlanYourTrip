rules_version = '2';

// Plan Your Trip — shared trips. Paste into Firebase console → Firestore Database → Rules → Publish.
//
// trips/{tripId}                                  the shared trip: ownerId, memberIds (owner first, ≤ 10) + data
// trips/{tripId}/expenses|activities|checklist|travelers|settlements/{id}   shared with every member
// trips/{tripId}/memberData/{uid}                 one member's own budget (only that member)
// trips/{tripId}/memberData/{uid}/packing/{id}    one member's own Packing list (only that member)
// trips/{tripId}/members/{uid}                    a member's display name, join time, left flag, the code they used
// trips/{tripId}/private/invite                   the owner's current invite code (only the owner)
// invites/{code}                                  a single-use invite: get by its exact code while open, never listed
// users/{uid}                                     the legacy copy's migration marker
// users/{uid}/trips/**                            the legacy copy (before shared trips): read until migrated, delete
//
// Field names match app/src/main/java/com/example/planyourtrip/data/sync/SyncDocuments.kt. Live documents contain
// every key (null when empty); a deleted item is a tombstone {deleted: true, updatedAt} (a trip tombstone keeps
// ownerId and memberIds, so members still learn about the delete). Everything not matched below is denied.
// Tests: rules-tests/ (Firebase Emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Common ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isDecimal(v) {
      return v is string && v.matches('^[0-9]+([.][0-9]+)?$');
    }

    function optString(v) {
      return v == null || v is string;
    }

    function optPositiveInt(v) {
      return v == null || (v is int && v > 0);
    }

    function isTombstone(d) {
      return d.keys().hasOnly(['deleted', 'updatedAt'])
        && d.deleted == true
        && d.updatedAt is int;
    }

    // ---------- Membership ----------

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function memberPath(tripId, uid) {
      return /databases/$(database)/documents/trips/$(tripId)/members/$(uid);
    }

    function memberDataPath(tripId, uid) {
      return /databases/$(database)/documents/trips/$(tripId)/memberData/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // Reads: a member of the trip as it is now.
    function isMember(tripId) {
      return signedIn()
        && exists(tripPath(tripId))
        && request.auth.uid in get(tripPath(tripId)).data.memberIds;
    }

    // Writes: a member of the trip as it is after this write (a new trip and its first children may be written in
    // one batch; leaving and writing in the same batch fails).
    function isMemberAfter(tripId) {
      return signedIn()
        && existsAfter(tripPath(tripId))
        && request.auth.uid in getAfter(tripPath(tripId)).data.memberIds;
    }

    function isTripOwner(tripId) {
      return signedIn()
        && exists(tripPath(tripId))
        && get(tripPath(tripId)).data.ownerId == request.auth.uid;
    }

    // Live (not deleted) after this write: only then can live child items be written.
    function isTripLiveAfter(tripId) {
      return getAfter(tripPath(tripId)).data.deleted == false;
    }

    // 1–10 members, no duplicates.
    function validMembers(m) {
      return m is list && m.size() >= 1 && m.size() <= 10 && m.toSet().size() == m.size();
    }

    // A child item (shared or personal) by a member: live only while the trip is live and valid for its [kind]; a
    // tombstone always (so a big trip can be deleted in several batches).
    function canWriteChild(tripId, kind, d) {
      return isMemberAfter(tripId) && (isTombstone(d) || (isTripLiveAfter(tripId) && validChild(kind, d)));
    }

    // Only the validation of the matching kind is evaluated.
    function validChild(kind, d) {
      return (kind == 'expense' && validExpense(d))
        || (kind == 'activity' && validActivity(d))
        || (kind == 'checklist' && validChecklistItem(d, 'BEFORE_TRIP'))
        || (kind == 'traveler' && validTraveler(d))
        || (kind == 'settlement' && validSettlement(d))
        || (kind == 'budget' && validBudget(d))
        || (kind == 'packing' && validChecklistItem(d, 'PACKING'));
    }

    // ---------- Invites ----------

    // 8 characters without look-alikes (no 0/O, 1/I/L): 31^8 ≈ 8.5·10^11 codes.
    function isCode(v) {
      return v is string && v.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$');
    }

    // A trip id as the app makes them (UUID); nothing that could point into another path.
    function isTripId(v) {
      return v is string && v.matches('^[A-Za-z0-9-]{1,64}$');
    }

    // Open and not older than 7 days. Expiry is computed from the server's createdAt, never stored by a client.
    function isOpenInvite(inv) {
      return inv.status == 'open'
        && inv.createdAt is timestamp
        && request.time < inv.createdAt + duration.value(7, 'd');
    }

    // [me] joins trip [tripId] in this very write: my member document names an invite that was open, unexpired and
    // for this trip before the write, and is used by me after it; I was not a member before and am one after.
    // Checked by all three documents of the join batch (trip, invite, member), so none can be written alone.
    function validJoin(tripId, me) {
      let code = getAfter(memberPath(tripId, me)).data.inviteCode;
      let before = get(invitePath(code)).data;
      let after = getAfter(invitePath(code)).data;
      return isCode(code)
        && before.tripId == tripId
        && isOpenInvite(before)
        && after.tripId == tripId
        && after.status == 'used'
        && after.usedBy == me
        && !(me in get(tripPath(tripId)).data.memberIds)
        && me in getAfter(tripPath(tripId)).data.memberIds;
    }

    // ---------- Field validation ----------

    // No budget here: each member's budget is personal (memberData).
    // The picked destination's country and coordinates. Optional: a trip without these keys (free text, or written
    // by an app version before destination suggestions) is valid; null means none. Latitude and longitude together.
    function validPlace(d) {
      let cc = d.get('countryCode', null);
      let lat = d.get('latitude', null);
      let lng = d.get('longitude', null);
      return (cc == null || (cc is string && cc.matches('^[A-Z]{2}$')))
        && ((lat == null && lng == null)
            || (lat is number && lng is number && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180));
    }

    function validTrip(d) {
      return d.keys().hasOnly(['destination', 'startDate', 'endDate', 'currencyCode', 'color', 'ownerId',
                               'memberIds', 'updatedAt', 'deleted', 'countryCode', 'latitude', 'longitude'])
        && d.destination is string && d.destination.size() > 0
        && isDate(d.startDate) && isDate(d.endDate) && d.endDate >= d.startDate
        && optString(d.currencyCode)
        && validPlace(d)
        && d.color is string
        && d.ownerId is string
        && validMembers(d.memberIds)
        && d.ownerId in d.memberIds
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validTripTombstone(d) {
      return d.keys().hasOnly(['ownerId', 'memberIds', 'deleted', 'updatedAt'])
        && d.ownerId is string
        && validMembers(d.memberIds)
        && d.deleted == true
        && d.updatedAt is int;
    }

    // A traveler key: a member's uid or a name-only traveler's uuid.
    function isTravelerKey(v) {
      return v is string && v.size() > 0 && v.size() <= 64;
    }

    function validExpense(d) {
      return d.keys().hasOnly(['name', 'amountAgorot', 'category', 'date', 'originalAmount', 'originalCurrency',
                               'exchangeRate', 'rateDate', 'paidBy', 'splitBetween', 'updatedAt', 'deleted'])
        && d.name is string && d.name.size() > 0
        && d.amountAgorot is int && d.amountAgorot > 0
        && d.category is string
        && isDate(d.date)
        && (d.originalAmount == null || isDecimal(d.originalAmount))
        && optString(d.originalCurrency)
        && (d.exchangeRate == null || isDecimal(d.exchangeRate))
        && (d.rateDate == null || isDate(d.rateDate))
        && isTravelerKey(d.paidBy)
        && d.splitBetween is list && d.splitBetween.size() > 0 && d.splitBetween.size() <= 50
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validActivity(d) {
      return d.keys().hasOnly(['date', 'startTime', 'title', 'note', 'type', 'location', 'estimatedCostAgorot',
                               'booked', 'updatedAt', 'deleted'])
        && isDate(d.date)
        && (d.startTime == null || (d.startTime is string && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && d.title is string && d.title.size() > 0
        && optString(d.note)
        && d.type is string
        && optString(d.location)
        && optPositiveInt(d.estimatedCostAgorot)
        && d.booked is bool
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validChecklistItem(d, list) {
      return d.keys().hasOnly(['list', 'text', 'checked', 'dueDate', 'createdAt', 'updatedAt', 'deleted'])
        && d.list == list
        && d.text is string && d.text.size() > 0
        && d.checked is bool
        && (d.dueDate == null || isDate(d.dueDate))
        && d.createdAt is int
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validTraveler(d) {
      return d.keys().hasOnly(['name', 'color', 'createdAt', 'updatedAt', 'deleted'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.color is string
        && d.createdAt is int
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validSettlement(d) {
      return d.keys().hasOnly(['fromTraveler', 'toTraveler', 'amountAgorot', 'date', 'createdAt', 'updatedAt',
                               'deleted'])
        && isTravelerKey(d.fromTraveler)
        && isTravelerKey(d.toTraveler)
        && d.fromTraveler != d.toTraveler
        && d.amountAgorot is int && d.amountAgorot > 0
        && isDate(d.date)
        && d.createdAt is int
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validBudget(d) {
      return d.keys().hasOnly(['budgetAgorot', 'updatedAt', 'deleted'])
        && optPositiveInt(d.budgetAgorot)
        && d.updatedAt is int
        && d.deleted == false;
    }

    // A member document: the display name only (never an email), when they joined (server time), whether they left,
    // and the invite code they joined with (null for the owner).
    function validMember(d) {
      return d.keys().hasOnly(['name', 'joinedAt', 'left', 'inviteCode'])
        && d.keys().hasAll(['name', 'joinedAt', 'left', 'inviteCode'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.joinedAt == request.time
        && d.left == false
        && (d.inviteCode == null || isCode(d.inviteCode));
    }

    // ---------- Trips ----------

    // Changes of an existing trip: by one of its members, or joining with an invite.
    function validTripUpdate(tripId) {
      let before = resource.data;
      let after = request.resource.data;
      let me = request.auth.uid;
      let isOwner = me == before.ownerId;
      return after.ownerId == before.ownerId
        && (
          (me in before.memberIds && (
            // The data (destination, dates, currency, color). Reviving a deleted trip: owner only.
            (after.memberIds == before.memberIds && validTrip(after) && (before.deleted == false || isOwner))
            // Deleting (tombstone): owner only.
            || (after.memberIds == before.memberIds && validTripTombstone(after) && isOwner)
            // The member list, nothing else: the owner removes others (and stays); a member removes only themselves
            // and deletes their own budget in the same write (marking their member document as left, if any).
            || (after.diff(before).affectedKeys().hasOnly(['memberIds'])
                && validMembers(after.memberIds)
                && (
                  (isOwner
                    && before.memberIds.hasAll(after.memberIds)
                    && after.memberIds.size() < before.memberIds.size()
                    && before.ownerId in after.memberIds)
                  || (!isOwner
                    && after.memberIds == before.memberIds.removeAll([me])
                    && !existsAfter(memberDataPath(tripId, me))
                    && (!existsAfter(memberPath(tripId, me)) || getAfter(memberPath(tripId, me)).data.left == true))
                ))
          ))
          // Joining: only my own uid is appended, to a live trip of at most 10 members, with a valid invite.
          || (!(me in before.memberIds)
              && before.deleted == false
              && after.diff(before).affectedKeys().hasOnly(['memberIds'])
              && after.memberIds == before.memberIds.concat([me])
              && validMembers(after.memberIds)
              && validJoin(tripId, me))
        );
    }

    match /trips/{tripId} {
      // A missing trip reads as "no document" (the app checks before creating one; ids are random UUIDs); an
      // existing one only for its members.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberIds);
      // Only the query "trips whose memberIds contain me".
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      // A new trip: I am its owner and only member.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && (validTrip(request.resource.data) || validTripTombstone(request.resource.data));
      allow update: if signedIn() && validTripUpdate(tripId);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      // ---------- Members ----------
      // Read by the members only. Written by that member themselves: the owner (no code) or someone joining with an
      // invite (validJoin). Marked as left (nothing else changes) when they leave or the owner removes them, in the
      // same write that takes them out of memberIds. Never deleted, so names stay on old expenses.

      match /members/{uid} {
        allow read: if isMember(tripId);
        allow create, update: if isSelf(uid)
          && validMember(request.resource.data)
          && (
            (request.resource.data.inviteCode == null && get(tripPath(tripId)).data.ownerId == uid)
            || (request.resource.data.inviteCode != null && validJoin(tripId, uid))
          );
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['left'])
          && request.resource.data.left == true
          && uid in get(tripPath(tripId)).data.memberIds
          && !(uid in getAfter(tripPath(tripId)).data.memberIds)
          && (isSelf(uid) || get(tripPath(tripId)).data.ownerId == request.auth.uid);
      }

      // The owner's current invite code (invites can't be listed): only the owner.
      match /private/{docId} {
        allow read, delete: if isTripOwner(tripId);
        allow create, update: if isTripOwner(tripId)
          && docId == 'invite'
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.keys().hasAll(['code'])
          && (request.resource.data.code == null || isCode(request.resource.data.code));
      }

      // ---------- Shared with every member ----------

      match /expenses/{expenseId} {
        allow read: if isMember(tripId);
        allow create, update: if canWriteChild(tripId, 'expense', request.resource.data);
        allow delete: if isTripOwner(tripId);
      }

      match /activities/{activityId} {
        allow read: if isMember(tripId);
        allow create, update: if canWriteChild(tripId, 'activity', request.resource.data);
        allow delete: if isTripOwner(tripId);
      }

      // "Before the trip" only; the Packing list is personal (memberData).
      match /checklist/{itemId} {
        allow read: if isMember(tripId);
        allow create, update: if canWriteChild(tripId, 'checklist', request.resource.data);
        allow delete: if isTripOwner(tripId);
      }

      // Name-only travelers (members are not traveler documents).
      match /travelers/{travelerId} {
        allow read: if isMember(tripId);
        allow create, update: if canWriteChild(tripId, 'traveler', request.resource.data);
        allow delete: if isTripOwner(tripId);
      }

      match /settlements/{settlementId} {
        allow read: if isMember(tripId);
        allow create, update: if canWriteChild(tripId, 'settlement', request.resource.data);
        allow delete: if isTripOwner(tripId);
      }

      // ---------- Personal: only that member, never the owner or the other members ----------
      // Reading and deleting my own personal data works even after I left or was removed (so I can clean it up);
      // writing needs me to be a member.

      match /memberData/{uid} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && canWriteChild(tripId, 'budget', request.resource.data);

        match /packing/{itemId} {
          allow read, delete: if isSelf(uid);
          allow create, update: if isSelf(uid)
            && canWriteChild(tripId, 'packing', request.resource.data);
        }
      }
    }

    // ---------- Invites ----------
    // invites/{code}: tripId, inviterName, destination, startDate, endDate, createdAt, status, usedBy.
    // Read only by its exact code while open and unexpired (a missing, used, cancelled or expired code, or a deleted
    // trip, are all denied the same way); never listed or deleted. Created only by the trip's owner, for a live trip
    // with fewer than 10 members, copying the trip's destination and dates; an existing code is an update and denied.
    // Cancelled by the owner; used once, in the join batch (validJoin).
    //
    // Rule lookups per batch (Firestore allows 20 per batch and 10 per document; the same document counts once):
    //   create invite (invite, pointer, owner's member document): trip, member            → 2 documents
    //   join (trip, invite, my member document):                  trip, invite, member      → 3 documents
    //   leave (trip, my member document, budget + packing deletes): trip, memberData, member → 3 documents
    //   remove a member (trip, their member document):            trip                      → 1 document
    // rules-tests run each batch at its largest size.

    function validNewInvite(code) {
      let d = request.resource.data;
      let trip = get(tripPath(d.tripId)).data;
      let me = request.auth.uid;
      return isCode(code)
        && d.keys().hasOnly(['tripId', 'inviterName', 'destination', 'startDate', 'endDate', 'createdAt', 'status',
                             'usedBy'])
        && d.keys().hasAll(['tripId', 'inviterName', 'destination', 'startDate', 'endDate', 'createdAt', 'status',
                            'usedBy'])
        && isTripId(d.tripId)
        && trip.ownerId == me
        && trip.deleted == false
        && trip.memberIds.size() < 10
        && d.destination == trip.destination
        && d.startDate == trip.startDate
        && d.endDate == trip.endDate
        && d.createdAt == request.time
        && d.status == 'open'
        && d.usedBy == null
        && d.inviterName == getAfter(memberPath(d.tripId, me)).data.name;
    }

    function validCancel() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['status'])
        && before.status == 'open'
        && after.status == 'cancelled'
        && get(tripPath(before.tripId)).data.ownerId == request.auth.uid;
    }

    function validUse(code) {
      let before = resource.data;
      let after = request.resource.data;
      let me = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['status', 'usedBy'])
        && isOpenInvite(before)
        && after.status == 'used'
        && after.usedBy == me
        && !(me in get(tripPath(before.tripId)).data.memberIds)
        && me in getAfter(tripPath(before.tripId)).data.memberIds
        && getAfter(memberPath(before.tripId, me)).data.inviteCode == code;
    }

    match /invites/{code} {
      allow get: if signedIn()
        && isOpenInvite(resource.data)
        && get(tripPath(resource.data.tripId)).data.deleted == false;
      allow list: if false;
      allow create: if signedIn() && validNewInvite(code);
      allow update: if signedIn() && (validCancel() || validUse(code));
      allow delete: if false;
    }

    // ---------- Legacy copy (before shared trips) ----------

    function legacyMigrated(uid) {
      let marker = /databases/$(database)/documents/users/$(uid);
      return exists(marker) && get(marker).data.get('sharedTripsMigrated', false) == true;
    }

    // Until the account is migrated, its own legacy copy can be read as before. After that, only with the exact
    // page size the new app's migration uses (450): old app versions read without a limit, so they are cut off
    // and keep their data on the phone, while leftovers of an interrupted migration can still be found and deleted.
    function canListLegacy(uid) {
      return isSelf(uid) && (!legacyMigrated(uid) || request.query.limit == 450);
    }

    // The migration marker: set once, never unset.
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['sharedTripsMigrated'])
        && request.resource.data.sharedTripsMigrated == true;
    }

    // Nothing can be written to the legacy copy any more; it is only read (to migrate it) and deleted.
    match /users/{uid}/trips/{tripId} {
      allow get: if isSelf(uid) && !legacyMigrated(uid);
      allow list: if canListLegacy(uid);
      allow delete: if isSelf(uid);

      // expenses, activities, checklist, travelers, settlements and the old places.
      match /{collection}/{docId} {
        allow get: if isSelf(uid) && !legacyMigrated(uid);
        allow list: if canListLegacy(uid);
        allow delete: if isSelf(uid);
      }
    }
  }
}
