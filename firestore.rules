rules_version = '2';

// Plan Your Trip: each signed-in user can read and write only their own documents under users/{uid}/trips/…;
// everything else is denied. Field names match app/src/main/java/com/example/planyourtrip/data/sync/SyncDocuments.kt.
// Live documents always contain every key (null when empty); a deleted item is a tombstone {deleted: true, updatedAt}.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isDecimal(v) {
      return v is string && v.matches('^[0-9]+([.][0-9]+)?$');
    }

    function optString(v) {
      return v == null || v is string;
    }

    function optPositiveInt(v) {
      return v == null || (v is int && v > 0);
    }

    function isTombstone(d) {
      return d.keys().hasOnly(['deleted', 'updatedAt'])
        && d.deleted == true
        && d.updatedAt is int;
    }

    function validTrip(d) {
      return d.keys().hasOnly(['destination', 'startDate', 'endDate', 'budgetAgorot', 'currencyCode', 'color',
                               'updatedAt', 'deleted'])
        && d.destination is string && d.destination.size() > 0
        && isDate(d.startDate) && isDate(d.endDate) && d.endDate >= d.startDate
        && optPositiveInt(d.budgetAgorot)
        && optString(d.currencyCode)
        && d.color is string
        && d.updatedAt is int
        && d.deleted == false;
    }

    // A traveler key: "me" (the account owner) or a traveler's uuid.
    function isTravelerKey(v) {
      return v is string && v.size() > 0 && v.size() <= 64;
    }

    // paidBy / splitBetween may be missing: documents written by app versions before expense splitting
    // (read as "paid by me, not shared").
    function validExpense(d) {
      return d.keys().hasOnly(['name', 'amountAgorot', 'category', 'date', 'originalAmount', 'originalCurrency',
                               'exchangeRate', 'rateDate', 'paidBy', 'splitBetween', 'updatedAt', 'deleted'])
        && d.name is string && d.name.size() > 0
        && d.amountAgorot is int && d.amountAgorot > 0
        && d.category is string
        && isDate(d.date)
        && (d.originalAmount == null || isDecimal(d.originalAmount))
        && optString(d.originalCurrency)
        && (d.exchangeRate == null || isDecimal(d.exchangeRate))
        && (d.rateDate == null || isDate(d.rateDate))
        && (!('paidBy' in d) || isTravelerKey(d.paidBy))
        && (!('splitBetween' in d)
            || (d.splitBetween is list && d.splitBetween.size() > 0 && d.splitBetween.size() <= 50))
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validActivity(d) {
      return d.keys().hasOnly(['date', 'startTime', 'title', 'note', 'type', 'location', 'estimatedCostAgorot',
                               'booked', 'updatedAt', 'deleted'])
        && isDate(d.date)
        && (d.startTime == null || (d.startTime is string && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && d.title is string && d.title.size() > 0
        && optString(d.note)
        && d.type is string
        && optString(d.location)
        && optPositiveInt(d.estimatedCostAgorot)
        && d.booked is bool
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validChecklistItem(d) {
      return d.keys().hasOnly(['list', 'text', 'checked', 'dueDate', 'createdAt', 'updatedAt', 'deleted'])
        && d.list is string
        && d.text is string && d.text.size() > 0
        && d.checked is bool
        && (d.dueDate == null || isDate(d.dueDate))
        && d.createdAt is int
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validTraveler(d) {
      return d.keys().hasOnly(['name', 'color', 'createdAt', 'updatedAt', 'deleted'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.color is string
        && d.createdAt is int
        && d.updatedAt is int
        && d.deleted == false;
    }

    function validSettlement(d) {
      return d.keys().hasOnly(['fromTraveler', 'toTraveler', 'amountAgorot', 'date', 'createdAt', 'updatedAt',
                               'deleted'])
        && isTravelerKey(d.fromTraveler)
        && isTravelerKey(d.toTraveler)
        && d.fromTraveler != d.toTraveler
        && d.amountAgorot is int && d.amountAgorot > 0
        && isDate(d.date)
        && d.createdAt is int
        && d.updatedAt is int
        && d.deleted == false;
    }

    match /users/{uid}/trips/{tripId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (isTombstone(request.resource.data) || validTrip(request.resource.data));

      match /expenses/{expenseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (isTombstone(request.resource.data) || validExpense(request.resource.data));
      }

      // Places were synced until the Map tab was removed. The app now only deletes what is left (once per
      // account); nothing can be written here any more.
      match /places/{placeId} {
        allow read, delete: if isOwner(uid);
      }

      match /activities/{activityId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (isTombstone(request.resource.data) || validActivity(request.resource.data));
      }

      // The Prep tab's checklists ("Before the trip", "Packing"). Trip documents are never uploaded.
      match /checklist/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (isTombstone(request.resource.data) || validChecklistItem(request.resource.data));
      }

      // Expense splitting: the people traveling with the user (names only, not accounts) and the payments
      // between them ("Settle up").
      match /travelers/{travelerId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (isTombstone(request.resource.data) || validTraveler(request.resource.data));
      }

      match /settlements/{settlementId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (isTombstone(request.resource.data) || validSettlement(request.resource.data));
      }
    }
  }
}
